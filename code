def main():
    # Увеличиваем таймаут запросов до 20 секунд для нестабильного соединения
    request = HTTPXRequest(connect_timeout=20.0, read_timeout=20.0)
    app = Application.builder().token(TOKEN).request(request).build()

    name_conv_handler = ConversationHandler(
        entry_points=[CallbackQueryHandler(start_change_name, pattern="^change_name_action$")],
        states={WAITING_FOR_NAME: [MessageHandler(filters.TEXT & ~filters.COMMAND, save_new_name)]},
        fallbacks=[],
    )

    app.add_handler(CommandHandler("pet", pet_command))
    app.add_handler(CommandHandler("opezdol", opezdol_command))
    app.add_handler(name_conv_handler)
    app.add_handler(CallbackQueryHandler(button_handler))

    print("🚀 Бот запущен! Все ошибки отловлены.")
    app.run_polling()

if __name__ == "__main__":
    main()
