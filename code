async def start_change_name(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    await query.message.reply_text("Введи новое имя для своего опездола:")
    return WAITING_FOR_NAME

async def save_new_name(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat_id = update.effective_chat.id
    pet = get_pet(chat_id)
    new_name = update.message.text.strip()
    pet["name"] = new_name
    
    await update.message.reply_text(
        f"🎉 Ура! Теперь опездола зовут: **{new_name}**",
        parse_mode="Markdown",
