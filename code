# Получить или создать питомца для конкретного чата
def get_pet(chat_id: int) -> dict:
    if chat_id not in pets_data:
        pets_data[chat_id] = {
            "name": "Опездол",
            "fullness": 100,        # Сытость (в %)
            "thirst": 100,          # Жажда (в %)
            "play_need": 0,         # Требование к играм (0% - доволен, 100% - скучает)
            "is_sleeping": False,   # Флаг сна
            "pee_need": "Не хочет",
            "poop_need": "Не хочет"
        }
    return pets_data[chat_id]

# Расчет настроения по шкале игр
def get_mood_text(pet: dict) -> str:
    need = pet["play_need"]
    if need <= 20:
        return "Отличное 😸"
    elif need <= 50:
        return "Нормальное 😐"
    elif need <= 80:
        return "Грустное 😿"
    else:
        return "Ужасное / Очень скучает 😭"

