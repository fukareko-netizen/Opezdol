def get_mood_text(pet: dict) -> str:
    need = pet["play_need"]
    if need <= 20: return "Отличное 😸"
    elif need <= 50: return "Нормальное 😐"
    elif need <= 80: return "Грустное 😿"
    else: return "Ужасное / Очень скучает 😭"

