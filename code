# Проверка туалета каждые 2 часа (7200 сек)
async def check_toilet_needs(context: ContextTypes.DEFAULT_TYPE):
    chat_id = context.job.chat_id
    pet = get_pet(chat_id)

    if pet["is_sleeping"]:
        return

    pet["pee_need"] = "Очень хочет!"
    pet["poop_need"] = "Очень хочет!"

    await context.bot.send_message(chat_id=chat_id, text=f"🚨 {pet['name']} хочет ссать!")
    await context.bot.send_message(chat_id=chat_id, text=f"🚨 {pet['name']} хочет срать!")

# Изменение показателей каждый час (3600 сек)
async def decrease_stats_hourly(context: ContextTypes.DEFAULT_TYPE):
    chat_id = context.job.chat_id
    pet = get_pet(chat_id)

    if pet["is_sleeping"]:
        return

    # Убавляем голод/жажду на 10%, прибавляем желание играть на 10%
    pet["fullness"] = max(0, pet["fullness"] - 10)
    pet["thirst"] = max(0, pet["thirst"] - 10)
    pet["play_need"] = min(100, pet["play_need"] + 10)

    if pet["fullness"] <= 20:
        await context.bot.send_message(
            chat_id=chat_id, 
            text=f"⚠️ {pet['name']} очень голоден! Сытость: {pet['fullness']}%"
        )
    if pet["thirst"] <= 20:
        await context.bot.send_message(
            chat_id=chat_id, 
            text=f"⚠️ {pet['name']} хочет пить! Жажда: {pet['thirst']}%"
        )
    if pet["play_need"] >= 80:
        await context.bot.send_message(
            chat_id=chat_id,
            text=f"🧸 {pet['name']} очень скучает! Поиграйте с ним!"
        )

# Настройка и запуск фоновых задач
def start_timers(context: ContextTypes.DEFAULT_TYPE, chat_id: int):
    if context.job_queue is None:
        return

    toilet_job = f"toilet_job_{chat_id}"
    stats_job = f"stats_job_{chat_id}"

    # Если таймеры еще не запущены для данного чата — запускаем
    current_jobs_toilet = context.job_queue.get_jobs_by_name(toilet_job)
    if not current_jobs_toilet:
        context.job_queue.run_repeating(
            check_toilet_needs, 
            interval=7200, 
            first=7200, 
            chat_id=chat_id, 
            name=toilet_job
        )

    current_jobs_stats = context.job_queue.get_jobs_by_name(stats_job)
    if not current_jobs_stats:
        context.job_queue.run_repeating(
            decrease_stats_hourly, 
            interval=3600, 
            first=3600, 
            chat_id=chat_id, 
            name=stats_job
        )

async def pet_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = [[
        InlineKeyboardButton("Да", callback_data="yes"),
        InlineKeyboardButton("Нет", callback_data="no")
    ]]
    await update.message.reply_text("Привет пиздюки! Дитя захотели?", reply_markup=InlineKeyboardMarkup(keyboard))

async def opezdol_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat_id = update.effective_chat.id
    start_timers(context, chat_id)
    await update.message.reply_text("Здесь разукрась его как хочешь", reply_markup=get_opezdol_keyboard(chat_id))

async def start_change_name(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    await query.message.reply_text("Введи новое имя для своего опездола:")
    return WAITING_FOR_NAME

async def save_new_name(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat_id = update.effective_chat.id
    pet = get_pet(chat_id)
    
    new_name = update.message.text.strip()
    pet["name"] = new_name
    
    await update.message.reply_text(
        f"🎉 Ура! Теперь опездола зовут: **{new_name}**",
        parse_mode="Markdown",
        reply_markup=get_opezdol_keyboard(chat_id)
    )
    return ConversationHandler.END

# Главный обработчик кнопок
async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    chat_id = query.message.chat_id
    pet = get_pet(chat_id)
    
    # Подстраховка таймеров
    start_timers(context, chat_id)
    await query.answer()

    if query.data == "no":
        await query.edit_message_text("Ну и пошли вы нахуй!")

    elif query.data == "yes":
        await query.edit_message_text("Ваш опездол родился! управляйте им через команду /opezdol")
        await query.message.reply_text("Здесь разукрась его как хочешь", reply_markup=get_opezdol_keyboard(chat_id))

    elif query.data == "back_to_menu":
        await query.edit_message_text("Здесь разукрась его как хочешь", reply_markup=get_opezdol_keyboard(chat_id))

    # --- Управление сном ---
    elif query.data == "action_sleep":
        pet["is_sleeping"] = True
        await query.edit_message_text(
            f"💤 **{pet['name']}** сладко спит. Все характеристики заморожены!",
            parse_mode="Markdown",
            reply_markup=get_opezdol_keyboard(chat_id)
        )

    elif query.data == "action_wake":
        pet["is_sleeping"] = False
        await query.edit_message_text(
            f"⏰ **{pet['name']}** проснулся и готов играть!",
            parse_mode="Markdown",
            reply_markup=get_opezdol_keyboard(chat_id)
        )

    # --- Игривость ---
    elif query.data == "action_play":
        if pet["is_sleeping"]:
            await query.answer("Опездол спит! Сначала разбуди его.", show_alert=True)
            return

        pet["play_need"] = max(0, pet["play_need"] - 30)
        await query.edit_message_text(
            f"🧸 Вы поиграли с **{pet['name']}**!\n"
            f"Потребность в играх упала до: {pet['play_need']}%\n"
            f"Настроение: {get_mood_text(pet)}",
            parse_mode="Markdown",
            reply_markup=get_opezdol_keyboard(chat_id)
        )

    # --- Еда ---
    elif query.data == "menu_food":
        if pet["is_sleeping"]:
            await query.answer("Опездол спит! Нельзя кормить во сне.", show_alert=True)
            return

        await query.edit_message_text(
            f"🍖 Чем покормим **{pet['name']}**?\nТекущая сытость: {pet['fullness']}%",
            parse_mode="Markdown",
            reply_markup=get_food_keyboard()
        )

    elif query.data.startswith("eat_"):
        food_item = query.data.split("_")[1]
        if pet["fullness"] >= 100:
            await query.answer("Опездол уже полностью сыт!", show_alert=True)
        else:
            pet["fullness"] = min(100, pet["fullness"] + 10)
            await query.edit_message_text(
                f"😋 {pet['name']} съел **{food_item}** (+10% сытости)!\n🍖 Текущая сытость: {pet['fullness']}%",
                parse_mode="Markdown",
                reply_markup=get_food_keyboard()
            )

    # --- Напитки ---
    elif query.data == "menu_drink":
        if pet["is_sleeping"]:
            await query.answer("Опездол спит! Нельзя поить во сне.", show_alert=True)
            return

        await query.edit_message_text(
            f"💧 Чем напоим **{pet['name']}**?\nТекущая жажда: {pet['thirst']}%",
            parse_mode="Markdown",
            reply_markup=get_drink_keyboard()
        )

    elif query.data.startswith("drink_"):
        drink_item = query.data.split("_")[1]
        if pet["thirst"] >= 100:
            await query.answer("Опездол уже не хочет пить!", show_alert=True)
        else:
            pet["thirst"] = min(100, pet["thirst"] + 10)
            await query.edit_message_text(
                f"🥤 {pet['name']} выпил **{drink_item}** (+10% жажды)!\n💧 Текущая жажда: {pet['thirst']}%",
                parse_mode="Markdown",
                reply_markup=get_drink_keyboard()
            )

    # --- Имя ---
    elif query.data == "stat_name":
        keyboard = [
            [InlineKeyboardButton("Сменить имя ✏️", callback_data="change_name_action")],
            [InlineKeyboardButton("🔙 Назад", callback_data="back_to_menu")]
        ]
        await query.edit_message_text(
            f"Текущее имя опездола: **{pet['name']}**", 
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )

    # --- Профиль ---
    elif query.data == "stat_profile":
        status_sleep = "😴 Спит" if pet["is_sleeping"] else "👁️ Бодрствует"

        profile_text = (
            f"📋 **Карточка опездола:**\n\n"
            f"👤 **Имя:** {pet['name']}\n"
            f"💤 **Статус:** {status_sleep}\n"
            f"🍖 **Сытость:** {pet['fullness']}%\n"
            f"💧 **Жажда:** {pet['thirst']}%\n"
            f"🎭 **Настроение:** {get_mood_text(pet)}\n"
            f"🧸 **Хочет играть:** {pet['play_need']}%\n"
            f"🚽 **Потребность пописять:** {pet['pee_need']}\n"
            f"💩 **Потребность покакать:** {pet['poop_need']}"
        )
        await query.message.reply_text(profile_text, parse_mode="Markdown", reply_markup=get_opezdol_keyboard(chat_id))

    # --- Туалет ---
    elif query.data == "stat_pee":
        pet["pee_need"] = "Не хочет"
        await query.message.reply_text(f"💦 {pet['name']} пописал и доволен!")

    elif query.data == "stat_poop":
        pet["poop_need"] = "Не хочет"
        await query.message.reply_text(f"💩 {pet['name']} покакал и доволен!")

def main():
    app = Application.builder().token(TOKEN).build()

    name_conv_handler = ConversationHandler(
        entry_points=[CallbackQueryHandler(start_change_name, pattern="^change_name_action$")],
        states={WAITING_FOR_NAME: [MessageHandler(filters.TEXT & ~filters.COMMAND, save_new_name)]},
        fallbacks=[],
    )

    app.add_handler(CommandHandler("pet", pet_command))
    app.add_handler(CommandHandler("opezdol", opezdol_command))
    app.add_handler(name_conv_handler)
    app.add_handler(CallbackQueryHandler(button_handler))

    print("🚀 Бот запущен!")
    app.run_polling()

if __name__ == "__main__":
    main()
