# Проверка туалета раз в 12 часов (43200 сек)
async def check_toilet_needs(context: ContextTypes.DEFAULT_TYPE):
    chat_id = context.job.chat_id

    pet_stats["pee_need"] = "Очень хочет!"
    pet_stats["poop_need"] = "Очень хочет!"

    await context.bot.send_message(
        chat_id=chat_id,
        text=f"🚨 {pet_stats['name']} хочет ссать!"
    )
    await context.bot.send_message(
        chat_id=chat_id,
        text=f"🚨 {pet_stats['name']} хочет срать!"
    )


# Уменьшение настроения раз в 2 часа (7200 сек)
async def decrease_mood_2hours(context: ContextTypes.DEFAULT_TYPE):
    chat_id = context.job.chat_id

    pet_stats["mood"] = max(0, pet_stats["mood"] - 10)

    if pet_stats["mood"] <= 20:
        await context.bot.send_message(
            chat_id=chat_id,
            text=f"😔 У {pet_stats['name']} плохое настроение ({pet_stats['mood']}%)! Пожалейте его."
        )


# Уменьшение голода и жажды каждый час (3600 сек)
async def decrease_stats_hourly(context: ContextTypes.DEFAULT_TYPE):
    chat_id = context.job.chat_id

    pet_stats["fullness"] = max(0, pet_stats["fullness"] - 10)
    pet_stats["thirst"] = max(0, pet_stats["thirst"] - 10)

    if pet_stats["fullness"] <= 20:
        await context.bot.send_message(
            chat_id=chat_id,
            text=f"⚠️ {pet_stats['name']} очень голоден! Сытость: {pet_stats['fullness']}%"
        )
    if pet_stats["thirst"] <= 20:
        await context.bot.send_message(
            chat_id=chat_id,
            text=f"⚠️ {pet_stats['name']} хочет пить! Жажда: {pet_stats['thirst']}%"
        )


# Запуск фоновых таймеров
def start_timers(context: ContextTypes.DEFAULT_TYPE, chat_id: int):
    # 1. Таймер туалета раз в 12 часов (43200 секунд)
    toilet_job_name = f"toilet_job_{chat_id}"
    for job in context.job_queue.get_jobs_by_name(toilet_job_name):
        job.schedule_removal()
    context.job_queue.run_repeating(
        check_toilet_needs,
        interval=43200,
        first=43200,
        chat_id=chat_id,
        name=toilet_job_name
    )

    # 2. Таймер настроения раз в 2 часа (7200 секунд)
    mood_job_name = f"mood_job_{chat_id}"
    for job in context.job_queue.get_jobs_by_name(mood_job_name):
        job.schedule_removal()
    context.job_queue.run_repeating(
        decrease_mood_2hours,
        interval=7200,
        first=7200,
        chat_id=chat_id,
        name=mood_job_name
    )

    # 3. Таймер каждый час (3600 секунд) - голод и жажда
    stats_job_name = f"stats_job_{chat_id}"
    for job in context.job_queue.get_jobs_by_name(stats_job_name):
        job.schedule_removal()
    context.job_queue.run_repeating(
        decrease_stats_hourly,
        interval=3600,
        first=3600,
        chat_id=chat_id,
        name=stats_job_name
    )


