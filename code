# Нажатие на "Сменить имя"
async def start_change_name(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    await query.message.reply_text("Введи новое имя для своего опездола:")
    return WAITING_FOR_NAME

# Сохранение нового имени
async def save_new_name(update: Update, context: ContextTypes.DEFAULT_TYPE):
    new_name = update.message.text.strip()
    pet_stats["name"] = new_name
    
    await update.message.reply_text(
        f"🎉 Ура! Теперь опездола зовут: **{new_name}**",
        parse_mode="Markdown",
        reply_markup=get_opezdol_keyboard()
    )
    return ConversationHandler.END

# Главный обработчик кнопок
async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    if query.data == "no":
        await query.edit_message_text("Ну и пошли вы нахуй!")
        
    elif query.data == "yes":
        await query.edit_message_text(
            "Ваш опездол родился! управляйте им через команду /opezdol"
        )
        start_timers(context, query.message.chat.id)

        await query.message.reply_text(
            "Здесь разукрась его как хочешь", 
            reply_markup=get_opezdol_keyboard()
        )

    elif query.data == "back_to_menu":
        await query.edit_message_text(
            "Здесь разукрась его как хочешь",
            reply_markup=get_opezdol_keyboard()
        )

    # Раздел Еды
    elif query.data == "menu_food":
        await query.edit_message_text(
            f"🍖 Чем покормим **{pet_stats['name']}**?\nТекущая сытость: {pet_stats['fullness']}%",
            parse_mode="Markdown",
            reply_markup=get_food_keyboard()
        )

    elif query.data.startswith("eat_"):
        food_item = query.data.split("_")[1]
        if pet_stats["fullness"] >= 100:
            await query.answer("Опездол уже полностью сыт!", show_alert=True)
        else:
            pet_stats["fullness"] = min(100, pet_stats["fullness"] + 10)
            await query.edit_message_text(
                f"😋 {pet_stats['name']} съел **{food_item}** (+10% сытости)!\n"
                f"🍖 Текущая сытость: {pet_stats['fullness']}%",
                parse_mode="Markdown",
                reply_markup=get_food_keyboard()
            )

    # Раздел Напитков
    elif query.data == "menu_drink":
        await query.edit_message_text(
            f"💧 Чем напоим **{pet_stats['name']}**?\nТекущая жажда: {pet_stats['thirst']}%",
            parse_mode="Markdown",
            reply_markup=get_drink_keyboard()
        )

    elif query.data.startswith("drink_"):
        drink_item = query.data.split("_")[1]
        if pet_stats["thirst"] >= 100:
            await query.answer("Опездол уже не хочет пить!", show_alert=True)
        else:
            pet_stats["thirst"] = min(100, pet_stats["thirst"] + 10)
            await query.edit_message_text(
                f"🥤 {pet_stats['name']} выпил **{drink_item}** (+10% жажды)!\n"
                f"💧 Текущая жажда: {pet_stats['thirst']}%",
                parse_mode="Markdown",
                reply_markup=get_drink_keyboard()
            )

    # Имя
    elif query.data == "stat_name":
        keyboard = [
            [InlineKeyboardButton("Сменить имя ✏️", callback_data="change_name_action")],
            [InlineKeyboardButton("🔙 Назад", callback_data="back_to_menu")]
        ]
        reply_markup = InlineKeyboardMarkup(keyboard)
        await query.edit_message_text(
            f"Текущее имя опездола: **{pet_stats['name']}**", 
            parse_mode="Markdown",
            reply_markup=reply_markup
        )

    # Профиль (Личность)
    elif query.data == "stat_profile":
        profile_text = (
            f"📋 **Карточка опездола:**\n\n"
            f"👤 **Имя:** {pet_stats['name']}\n"
            f"🍖 **Сытость:** {pet_stats['fullness']}%\n"
            f"💧 **Жажда:** {pet_stats['thirst']}%\n"
            f"🎭 **Настроение:** {pet_stats['mood']}\n"
            f"🚽 **Потребность пописять:** {pet_stats['pee_need']}\n"
            f"💩 **Потребность покакать:** {pet_stats['poop_need']}"
        )
        await query.message.reply_text(
            profile_text, 
            parse_mode="Markdown",
            reply_markup=get_opezdol_keyboard()
        )

    # Пописить / Покакать
    elif query.data == "stat_pee":
        pet_stats["pee_need"] = "Не хочет"
        await query.message.reply_text(f"💦 {pet_stats['name']} пописал и доволен!")

    elif query.data == "stat_poop":
        pet_stats["poop_need"] = "Не хочет"
        await query.message.reply_text(f"💩 {pet_stats['name']} покакал и доволен!")
        
    elif query.data.startswith("stat_"):
        stat_name = query.data.split("_")[1]
        await query.answer(f"Нажата кнопка: {stat_name}", show_alert=True)

def main():
    # Явно включаем поддержку JobQueue
    app = (
        Application.builder()
        .token(TOKEN)
        .job_queue(True)
        .build()
    )

    name_conv_handler = ConversationHandler(
        entry_points=[CallbackQueryHandler(start_change_name, pattern="^change_name_action$")],
        states={
            WAITING_FOR_NAME: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, save_new_name)
            ],
        },
        fallbacks=[],
    )

    app.add_handler(CommandHandler("pet", pet_command))
    app.add_handler(CommandHandler("opezdol", opezdol_command))
    app.add_handler(name_conv_handler)
    app.add_handler(CallbackQueryHandler(button_handler))

    print("Бот запущен!")
    app.run_polling()

if __name__ == "__main__":
    main()
