# ТАЙМЕР: Раз в 10 секунд (меняй 10 на нужное кол-во секунд)
async def decrease_stats_regularly(context: ContextTypes.DEFAULT_TYPE):
    chat_id = context.job.chat_id
    pet = get_pet(chat_id)

    if pet["is_sleeping"]:
        return

    pet["fullness"] = max(0, pet["fullness"] - 10)
    pet["thirst"] = max(0, pet["thirst"] - 10)
    pet["play_need"] = min(100, pet["play_need"] + 10)
    pet["pee_need"] = min(100, pet["pee_need"] + 15)
    pet["poop_need"] = min(100, pet["poop_need"] + 15)

    if pet["pee_need"] >= 80:
        try:
            await context.bot.send_message(
                chat_id=chat_id,
                text=f"🚨 {pet['name']} очень хочет ссать! Потребность: {pet['pee_need']}%"
            )
        except Exception:
            pass

    if pet["poop_need"] >= 80:
        try:
            await context.bot.send_message(
                chat_id=chat_id,
                text=f"🚨 {pet['name']} очень хочет срать! Потребность: {pet['poop_need']}%"
            )
        except Exception:
            pass

def ensure_timer_running(context: ContextTypes.DEFAULT_TYPE, chat_id: int):
    if context.job_queue is None:
        return

    job_name = f"stats_job_{chat_id}"
    current_jobs = context.job_queue.get_jobs_by_name(job_name)
    
    if not current_jobs:
        # Таймер настроен на 10 секунд
        context.job_queue.run_repeating(
            decrease_stats_regularly, 
            interval=10, 
            first=10, 
            chat_id=chat_id, 
            name=job_name
        )

async def safe_edit_text(query, text, reply_markup=None, parse_mode="Markdown"):
    """Безопасное редактирование сообщений с защитой от ошибок Telegram"""
    try:
        await query.edit_message_text(text=text, reply_markup=reply_markup, parse_mode=parse_mode)
    except BadRequest as e:
        if "Message is not modified" in str(e):
            pass # Если текст тот же, просто игнорируем
        else:
            raise e
    except TimedOut:
        pass # Игнорируем временные тайм-ауты сети

async def pet_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat_id = update.effective_chat.id
    ensure_timer_running(context, chat_id)
    keyboard = [[
